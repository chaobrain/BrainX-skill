+    elapsed_seconds: float,

+) -> dict[str, Any]:

+    run_id = f"seed-{seed}_{condition['id']}"

+    npz_path = output_dir / "raw" / f"{run_id}.npz"

+    json_path = output_dir / "metrics" / f"{run_id}.json"

